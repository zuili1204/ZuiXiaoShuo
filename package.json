{
  "name": "zuixiaoshuo",
  "version": "1.0.0",
  "description": "醉小说 - AI 辅助长篇小说创作工具",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build:electron": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "test": "vitest run",
    "eval:plan": "vitest run scripts/plan-eval/report.test.ts",
    "e2e": "playwright test",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "electron ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1",
    "@radix-ui/react-select": "2.1",
    "@radix-ui/react-slot": "1.1",
    "@radix-ui/react-tooltip": "1.1",
    "@tanstack/react-query": "^5.62.0",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.9.0",
    "electron-store": "^10.0.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.1.0",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.49.0",
    "postcss": "^8.5.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "2.1"
  },
  "build": {
    "appId": "com.zuixiaoshuo.app",
    "productName": "醉小说",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "scripts/style-metrics-lib.cjs",
      "src/skills/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
